<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WinCraft Cut-List — QWeb PDF Report Template
         Used by fabricators to cut frame profiles and glass panes.
         ═══════════════════════════════════════════════════════════════════════ -->

    <template id="report_wincraft_cutlist">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="project">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Fabrication Cut-List</h2>
                        <p>
                            <strong>Project:</strong> <span t-field="project.ref"/>
                            — <span t-field="project.name"/><br/>
                            <strong>Customer:</strong> <span t-field="project.partner_id.name"/><br/>
                            <strong>Date:</strong> <span t-field="project.create_date" t-options="{'widget': 'date'}"/>
                        </p>

                        <table class="table table-sm table-bordered mt-3">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Window</th>
                                    <th>Type</th>
                                    <th>Material</th>
                                    <th>Frame (mm)</th>
                                    <th>Glass Cut (mm)</th>
                                    <th>Pane Size (mm)</th>
                                    <th>Panes</th>
                                    <th>Glass</th>
                                    <th>Area (m²)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="cut_data" t-as="cd">
                                    <tr>
                                        <td><t t-esc="cd_index + 1"/></td>
                                        <td><span t-esc="cd['window'].name"/></td>
                                        <td><span t-esc="cd['window'].window_type"/></td>
                                        <td><t t-esc="cd['material']"/></td>
                                        <td>
                                            <t t-esc="cd['frame_width']"/> × <t t-esc="cd['frame_height']"/>
                                        </td>
                                        <td>
                                            <t t-esc="cd['glass_width']"/> × <t t-esc="cd['glass_height']"/>
                                        </td>
                                        <td>
                                            <t t-esc="cd['pane_width']"/> × <t t-esc="cd['pane_height']"/>
                                        </td>
                                        <td><t t-esc="cd['pane_count']"/></td>
                                        <td><t t-esc="cd['glass']"/></td>
                                        <td><t t-esc="cd['area_sqm']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="mt-4 text-muted small">
                            <p>Generated by WinCraft Studio. All dimensions in millimetres unless specified.</p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
