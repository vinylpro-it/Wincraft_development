    <!-- Quote history snapshot for Project 3 (revision 1) -->
    <record id="history_mehra_v1" model="wincraft.quote.history">
        <field name="project_id" ref="project_demo_mehra"/>
        <field name="version">1</field>
        <field name="subtotal">185000</field>
        <field name="total">211930</field>
        <field name="window_data">[{"name": "Bay 2400×1500", "window_type": "bay", "width_mm": 2400, "height_mm": 1500, "unit_price": 156000}, {"name": "Hopper 800×500", "window_type": "hopper", "width_mm": 800, "height_mm": 500, "unit_price": 14000}]</field>
