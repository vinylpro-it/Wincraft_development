    <!-- ── Demo Project 3 — Via Dealer (Quoted with history) ───────────────── -->
    <record id="project_demo_mehra" model="wincraft.project">
        <field name="name">Mehra Showroom — Display Window Wall</field>
        <field name="partner_id" ref="partner_demo_mehra"/>
