<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WinCraft Studio — Demo Data
         Loaded when 'Demonstration Data' is enabled at install.
         Provides sample clients, dealers, projects covering all window types,
         and a quote-history snapshot.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Demo Customers ──────────────────────────────────────────────────── -->
    <record id="partner_demo_greenfield" model="res.partner">
        <field name="name">Greenfield Builders Pvt. Ltd.</field>
        <field name="company_type">company</field>
        <field name="street">Plot 42, Industrial Area Phase-II</field>
        <field name="city">Pune</field>
        <field name="phone">+91 20 2765 1234</field>
        <field name="email">projects@greenfield-builders.example.com</field>
    </record>
    <record id="partner_demo_sharma" model="res.partner">
        <field name="name">Rajesh Sharma</field>
        <field name="company_type">person</field>
        <field name="street">Flat 301, Sunrise Towers</field>
        <field name="city">Mumbai</field>
        <field name="phone">+91 98765 43210</field>
        <field name="email">rajesh.sharma@example.com</field>
    </record>
    <record id="partner_demo_mehra" model="res.partner">
        <field name="name">Priya Mehra Interiors</field>
        <field name="company_type">company</field>
        <field name="street">12-A, MG Road</field>
        <field name="city">Bangalore</field>
        <field name="phone">+91 80 2558 4321</field>
        <field name="email">priya@mehra-interiors.example.com</field>
    </record>

    <!-- ── Demo Dealer ─────────────────────────────────────────────────────── -->
    <record id="dealer_demo_citywindows" model="wincraft.dealer">
        <field name="name">City Windows &amp; Doors</field>
        <field name="partner_id" ref="partner_demo_mehra"/>
        <field name="code">DLR-001</field>
        <field name="commission_pct">8.0</field>
        <field name="territory">South Bangalore</field>
        <field name="credit_limit">500000</field>
    </record>

    <!-- ── Demo Project 1 — Commercial (Quoted) ────────────────────────────── -->
    <record id="project_demo_greenfield" model="wincraft.project">
        <field name="name">Greenfield Phase-II — Tower A</field>
        <field name="partner_id" ref="partner_demo_greenfield"/>
        <field name="state">designing</field>
        <field name="installation_charge">25000</field>
        <field name="discount_pct">5</field>
        <field name="terms">1. 50% advance on order confirmation.
2. Balance due before dispatch.
3. Delivery within 21 working days from confirmed measurements.
4. Warranty: 10 years on profiles, 5 years on hardware.</field>
    </record>

    <!-- Windows for Project 1 — casement, sliding, fixed -->
    <record id="win_gf_casement_1" model="wincraft.window">
        <field name="project_id" ref="project_demo_greenfield"/>
        <field name="window_type">casement</field>
        <field name="width_mm">1200</field>
        <field name="height_mm">1000</field>
        <field name="panels_horizontal">2</field>
        <field name="panels_vertical">1</field>
        <field name="frame_material_id" ref="mat_upvc_white"/>
        <field name="glass_type_id" ref="glass_double_24mm"/>
        <field name="canvas_x">50</field>
        <field name="canvas_y">60</field>
    </record>
    <record id="win_gf_sliding_1" model="wincraft.window">
        <field name="project_id" ref="project_demo_greenfield"/>
        <field name="window_type">sliding</field>
        <field name="width_mm">1800</field>
        <field name="height_mm">1200</field>
        <field name="panels_horizontal">2</field>
        <field name="panels_vertical">1</field>
        <field name="frame_material_id" ref="mat_upvc_white"/>
        <field name="glass_type_id" ref="glass_double_24mm"/>
        <field name="canvas_x">1400</field>
        <field name="canvas_y">60</field>
    </record>
    <record id="win_gf_fixed_1" model="wincraft.window">
        <field name="project_id" ref="project_demo_greenfield"/>
        <field name="window_type">fixed</field>
        <field name="width_mm">1500</field>
        <field name="height_mm">1500</field>
        <field name="frame_material_id" ref="mat_aluminium_natural"/>
        <field name="glass_type_id" ref="glass_triple_lowe"/>
        <field name="canvas_x">50</field>
        <field name="canvas_y">1400</field>
    </record>

