<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="wincraft_window_type_kind_view_form" model="ir.ui.view">
            <field name="name">wincraft.window.type.kind.form</field>
            <field name="model">wincraft.window.type.kind</field>
            <field name="arch" type="xml">
                <form string="Window Type Kind">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wincraft_window_type_kind_view_list" model="ir.ui.view">
            <field name="name">wincraft.window.type.kind.list</field>
            <field name="model">wincraft.window.type.kind</field>
            <field name="arch" type="xml">
                <list string="Window Type Kinds" default_order="sequence">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="wincraft_window_type_kind_action" model="ir.actions.act_window">
            <field name="name">Window Type Kinds</field>
            <field name="res_model">wincraft.window.type.kind</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
