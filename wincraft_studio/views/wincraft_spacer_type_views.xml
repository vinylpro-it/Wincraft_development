<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record id="wincraft_spacer_type_view_form" model="ir.ui.view">
            <field name="name">wincraft.spacer.type.form</field>
            <field name="model">wincraft.spacer.type</field>
            <field name="arch" type="xml">
                <form string="Spacer Type">
                    <sheet>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <group>
                            <group string="Details">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="sequence"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="wincraft_spacer_type_view_list" model="ir.ui.view">
            <field name="name">wincraft.spacer.type.list</field>
            <field name="model">wincraft.spacer.type</field>
            <field name="arch" type="xml">
                <list string="Spacer Types" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="wincraft_spacer_type_action" model="ir.actions.act_window">
            <field name="name">Spacer Types</field>
            <field name="res_model">wincraft.spacer.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a spacer type option
                </p>
                <p>Spacer types appear in the sealed-unit configuration dropdowns of the designer.</p>
            </field>
        </record>

    </data>
</odoo>
