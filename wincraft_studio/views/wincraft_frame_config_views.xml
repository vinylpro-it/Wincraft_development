<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Frame Config List View ── -->
    <record id="view_wincraft_frame_config_list" model="ir.ui.view">
        <field name="name">wincraft.frame.config.list</field>
        <field name="model">wincraft.frame.config</field>
        <field name="arch" type="xml">
            <list string="Frame Product Mappings" editable="bottom">
                <field name="profile_type_id" optional="show"/>
                <field name="opening_type" optional="show"/>
                <field name="product_tmpl_id" optional="show"/>
                <field name="product_code" optional="show" readonly="1"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Frame Config Form View ── -->
    <record id="view_wincraft_frame_config_form" model="ir.ui.view">
        <field name="name">wincraft.frame.config.form</field>
        <field name="model">wincraft.frame.config</field>
        <field name="arch" type="xml">
            <form string="Frame Product Mapping">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Canvas Mapping">
                            <field name="profile_type_id"/>
                            <field name="opening_type"/>
                        </group>
                        <group string="Odoo Product">
                            <field name="product_tmpl_id"/>
                            <field name="product_code" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Default Attribute Values">
                        <field name="default_attr_values" widget="json"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Frame Config Search View ── -->
    <record id="view_wincraft_frame_config_search" model="ir.ui.view">
        <field name="name">wincraft.frame.config.search</field>
        <field name="model">wincraft.frame.config</field>
        <field name="arch" type="xml">
            <search string="Frame Product Mappings">
                <field name="profile_type_id"/>
                <field name="opening_type"/>
                <field name="product_tmpl_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Profile Type" name="by_profile" context="{'group_by': 'profile_type_id'}"/>
                    <filter string="Opening Type" name="by_ot" context="{'group_by': 'opening_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Frame Config Action ── -->
    <record id="action_wincraft_frame_config" model="ir.actions.act_window">
        <field name="name">Frame Product Mappings</field>
        <field name="res_model">wincraft.frame.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No frame product mappings yet.
            </p>
            <p>
                Map each <strong>Opening Type + Profile Type</strong> to the
                corresponding frame <strong>Product</strong> so that WinCraft Studio
                can build accurate BOMs and Sale Orders.
            </p>
        </field>
    </record>
</odoo>
