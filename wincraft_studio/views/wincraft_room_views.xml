<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="wincraft_room_view_form" model="ir.ui.view">
            <field name="name">wincraft.room.form</field>
            <field name="model">wincraft.room</field>
            <field name="arch" type="xml">
                <form string="Room">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wincraft_room_view_list" model="ir.ui.view">
            <field name="name">wincraft.room.list</field>
            <field name="model">wincraft.room</field>
            <field name="arch" type="xml">
                <list string="Rooms" default_order="sequence, name" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="wincraft_room_action" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="res_model">wincraft.room</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No rooms yet.
                </p>
                <p>
                    Add the rooms windows can be assigned to — these become
                    the "Room" choices in the canvas Window Configuration
                    popup (Others section).
                </p>
            </field>
        </record>

    </data>
</odoo>
