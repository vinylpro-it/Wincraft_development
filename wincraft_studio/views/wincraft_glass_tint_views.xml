<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record id="wincraft_glass_tint_view_form" model="ir.ui.view">
            <field name="name">wincraft.glass.tint.form</field>
            <field name="model">wincraft.glass.tint</field>
            <field name="arch" type="xml">
                <form string="Glass Tint">
                    <sheet>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <group>
                            <group string="Details">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="hex_colour" widget="color"/>
                                <field name="sequence"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="wincraft_glass_tint_view_list" model="ir.ui.view">
            <field name="name">wincraft.glass.tint.list</field>
            <field name="model">wincraft.glass.tint</field>
            <field name="arch" type="xml">
                <list string="Glass Tints" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="hex_colour" widget="color"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="wincraft_glass_tint_action" model="ir.actions.act_window">
            <field name="name">Glass Tints</field>
            <field name="res_model">wincraft.glass.tint</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a glass tint option
                </p>
                <p>Glass tints appear as colour swatches in the designer properties panel.</p>
            </field>
        </record>

    </data>
</odoo>
