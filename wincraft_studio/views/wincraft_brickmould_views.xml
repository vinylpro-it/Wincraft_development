<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══ Brickmould ═════════════════════════════════════════════════
             Minimal admin-manageable catalog (WS-17) — Brickmould type on
             the Window Configuration popup. Same shape as wincraft.color:
             name/code/sequence/active, no CSV import path. -->
        <record id="wincraft_brickmould_view_form" model="ir.ui.view">
            <field name="name">wincraft.brickmould.form</field>
            <field name="model">wincraft.brickmould</field>
            <field name="arch" type="xml">
                <form string="Brickmould Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wincraft_brickmould_view_list" model="ir.ui.view">
            <field name="name">wincraft.brickmould.list</field>
            <field name="model">wincraft.brickmould</field>
            <field name="arch" type="xml">
                <list string="Brickmould Types" default_order="sequence, name">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="wincraft_brickmould_action" model="ir.actions.act_window">
            <field name="name">Brickmould Types</field>
            <field name="res_model">wincraft.brickmould</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No brickmould types yet.
                </p>
                <p>
                    Add the brickmould types your shop offers — these become
                    the "Brickmould type" choices in the canvas Window
                    Configuration popup.
                </p>
            </field>
        </record>

    </data>
</odoo>
