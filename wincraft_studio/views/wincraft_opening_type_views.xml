<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="wincraft_opening_type_view_form" model="ir.ui.view">
            <field name="name">wincraft.opening.type.form</field>
            <field name="model">wincraft.opening.type</field>
            <field name="arch" type="xml">
                <form string="Opening Type">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="key"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="hardware_roles"/>
                                <field name="pill_fields"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wincraft_opening_type_view_list" model="ir.ui.view">
            <field name="name">wincraft.opening.type.list</field>
            <field name="model">wincraft.opening.type</field>
            <field name="arch" type="xml">
                <list string="Opening Types" default_order="sequence">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="key"/>
                    <field name="hardware_roles"/>
                    <field name="pill_fields"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="wincraft_opening_type_action" model="ir.actions.act_window">
            <field name="name">Opening Types</field>
            <field name="res_model">wincraft.opening.type</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
