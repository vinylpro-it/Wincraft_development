<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Window Configuration catalogs (client redesign) — name / code /
             description lookups behind the Window Configuration form. -->

        <record id="wincraft_view_from_view_form" model="ir.ui.view">
            <field name="name">wincraft.view_from.form</field>
            <field name="model">wincraft.view_from</field>
            <field name="arch" type="xml">
                <form string="View From">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="description"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wincraft_view_from_view_list" model="ir.ui.view">
            <field name="name">wincraft.view_from.list</field>
            <field name="model">wincraft.view_from</field>
            <field name="arch" type="xml">
                <list string="View From Options" default_order="sequence, name">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="wincraft_view_from_action" model="ir.actions.act_window">
            <field name="name">View From Options</field>
            <field name="res_model">wincraft.view_from</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No view from options yet.</p>
            </field>
        </record>

