<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         AI Assistant — Form View
         ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_wincraft_ai_assistant_form" model="ir.ui.view">
        <field name="name">wincraft.ai.assistant.form</field>
        <field name="model">wincraft.ai.assistant</field>
        <field name="arch" type="xml">
            <form string="AI Assistant">
                <header>
                    <button name="action_generate_suggestions" type="object"
                            string="Generate Suggestions" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="energy_score" widget="progressbar"/>
                            <field name="energy_rating"/>
                        </group>
                    </group>
                    <separator string="Suggestions"/>
                    <field name="suggestion_ids">
                        <list>
                            <field name="category" widget="badge"
                                   decoration-info="category == 'info'"
                                   decoration-success="category == 'energy'"
                                   decoration-warning="category in ('structural','safety')"
                                   decoration-danger="category == 'performance'"/>
                            <field name="title"/>
                            <field name="description"/>
                            <field name="window_id"/>
                            <field name="applied"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wincraft_ai_assistant_list" model="ir.ui.view">
        <field name="name">wincraft.ai.assistant.list</field>
        <field name="model">wincraft.ai.assistant</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="energy_score" widget="progressbar"/>
                <field name="energy_rating"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_wincraft_ai_assistant" model="ir.actions.act_window">
        <field name="name">AI Assistant</field>
        <field name="res_model">wincraft.ai.assistant</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
