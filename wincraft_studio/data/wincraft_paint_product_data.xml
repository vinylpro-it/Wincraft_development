<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- ═══════════════════════════════════════════════════════════════════════
         WinCraft Studio — Starter Paint Product Catalog
         Real storable inventory products (litres) an admin can extend from
         Inventory → Paint Products. wincraft.window.inside/outside_paint_product_id
         default to "White" so every new window starts fully configured.
         noupdate="1" — these become live inventory records (stock, price) that
         must not be reset on every module upgrade.
         ═══════════════════════════════════════════════════════════════════════ -->

    <record id="product_paint_white" model="product.template">
        <field name="name">White</field>
        <field name="default_code">PAINT-WHITE</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="sale_ok">False</field>
        <field name="purchase_ok">True</field>
        <field name="uom_id" ref="uom.product_uom_litre"/>
        <field name="x_is_paint_product">True</field>
        <field name="x_paint_colour_hex">#f0ede8</field>
        <field name="x_paint_consumption_per_inch">1.0</field>
        <field name="x_paint_layers">1</field>
    </record>

