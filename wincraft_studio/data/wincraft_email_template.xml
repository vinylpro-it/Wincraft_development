<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WinCraft Studio — Email Template for Quote
         Sent automatically when a project moves to 'quoted' state.
         ═══════════════════════════════════════════════════════════════════════ -->

    <record id="email_template_wincraft_quote" model="mail.template">
        <field name="name">WinCraft: Quotation</field>
        <field name="model_id" ref="model_wincraft_project"/>
        <field name="subject">Quotation {{ object.ref }} — {{ object.name }}</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or '') }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;background:#f8f8f6;padding:24px;">
    <div style="max-width:640px;margin:0 auto;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e0ddd8;">
        <!-- Header with company logo -->
        <div style="background:#2c2c2a;padding:24px 32px;text-align:center;">
            <img t-if="object.company_id.logo"
                 t-att-src="'data:image/png;base64,' + object.company_id.logo.decode('utf-8')"
                 style="max-height:60px;max-width:200px;" alt="Company Logo"/>
            <h2 style="color:#e8c97a;margin:12px 0 0;font-size:20px;font-weight:600;">Window Quotation</h2>
        </div>

        <div style="padding:32px;">
            <!-- Greeting -->
            <p style="font-size:15px;color:#333;">Dear {{ object.partner_id.name }},</p>
            <p style="font-size:14px;color:#555;">
                Your quotation <strong style="color:#714b67;">{{ object.ref }}</strong>
                for project <strong>{{ object.name }}</strong> is ready for your review.
            </p>

            <!-- Window summary table -->
            <table style="width:100%;border-collapse:collapse;margin:20px 0;font-size:13px;">
                <thead>
                    <tr style="background:#f4f2ee;">
                        <th style="padding:8px 12px;text-align:left;border-bottom:2px solid #e0ddd8;">Window</th>
                        <th style="padding:8px 12px;text-align:left;border-bottom:2px solid #e0ddd8;">Dimensions</th>
                        <th style="padding:8px 12px;text-align:left;border-bottom:2px solid #e0ddd8;">Frame</th>
                        <th style="padding:8px 12px;text-align:left;border-bottom:2px solid #e0ddd8;">Glass</th>
                        <th style="padding:8px 12px;text-align:right;border-bottom:2px solid #e0ddd8;">Price</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="object.window_ids" t-as="win">
                        <tr>
                            <td style="padding:6px 12px;border-bottom:1px solid #eee;">{{ win.name or 'Window' }}</td>
                            <td style="padding:6px 12px;border-bottom:1px solid #eee;">{{ win.width_mm }} × {{ win.height_mm }} mm</td>
                            <td style="padding:6px 12px;border-bottom:1px solid #eee;">{{ win.frame_material_id.name or '-' }}</td>
                            <td style="padding:6px 12px;border-bottom:1px solid #eee;">{{ win.glass_type_id.name or '-' }}</td>
                            <td style="padding:6px 12px;border-bottom:1px solid #eee;text-align:right;">{{ object.currency_id.symbol }}{{ '%.0f' % win.unit_price }}</td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <!-- Totals block -->
            <table style="width:280px;margin-left:auto;font-size:13px;border-collapse:collapse;">
                <tr>
                    <td style="padding:4px 8px;">Subtotal</td>
                    <td style="padding:4px 8px;text-align:right;">{{ object.currency_id.symbol }}{{ '%.0f' % object.subtotal_price }}</td>
                </tr>
                <tr t-if="object.installation_charge > 0">
                    <td style="padding:4px 8px;">Installation</td>
                    <td style="padding:4px 8px;text-align:right;">{{ object.currency_id.symbol }}{{ '%.0f' % object.installation_charge }}</td>
                </tr>
                <tr t-if="object.discount_pct > 0">
                    <td style="padding:4px 8px;">Discount ({{ object.discount_pct }}%)</td>
                    <td style="padding:4px 8px;text-align:right;color:#dc3545;">-{{ object.currency_id.symbol }}{{ '%.0f' % object.discount_amount }}</td>
                </tr>
                <tr>
                    <td style="padding:4px 8px;">Tax ({{ object.gst_pct }}%)</td>
                    <td style="padding:4px 8px;text-align:right;">{{ object.currency_id.symbol }}{{ '%.0f' % object.tax_amount }}</td>
                </tr>
                <tr style="border-top:2px solid #2c2c2a;font-weight:700;">
                    <td style="padding:8px;font-size:15px;">Grand Total</td>
                    <td style="padding:8px;text-align:right;font-size:15px;color:#714b67;">{{ object.currency_id.symbol }}{{ '%.0f' % object.total_price }}</td>
                </tr>
            </table>

            <!-- Portal link button -->
            <div style="text-align:center;margin:28px 0;">
                <a t-att-href="ctx.get('portal_url', '')"
                   style="display:inline-block;background:#714b67;color:#ffffff;padding:12px 32px;border-radius:6px;text-decoration:none;font-size:15px;font-weight:600;">
                    View &amp; Approve Online
                </a>
            </div>

            <!-- Validity -->
            <p t-if="object.due_date" style="font-size:13px;color:#777;text-align:center;">
                This quotation is valid until <strong>{{ object.due_date }}</strong>.
            </p>
        </div>

        <!-- Company footer -->
        <div style="background:#f4f2ee;padding:16px 32px;font-size:12px;color:#888;border-top:1px solid #e0ddd8;">
            <strong>{{ object.company_id.name }}</strong><br/>
            <t t-if="object.company_id.phone">Phone: {{ object.company_id.phone }} | </t>
            <t t-if="object.company_id.email">Email: {{ object.company_id.email }}</t>
            <t t-if="object.company_id.vat"><br/>GSTIN: {{ object.company_id.vat }}</t>
        </div>
    </div>
</div>
        </field>
        <field name="report_template_ids" eval="[(4, ref('action_wincraft_quote_report'))]"/>
    </record>

</odoo>
