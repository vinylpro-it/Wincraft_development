<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Sequences ── -->
        <record id="seq_wincraft_delivery" model="ir.sequence">
            <field name="name">WinCraft Delivery</field>
            <field name="code">wincraft.delivery</field>
            <field name="prefix">DEL/%(y)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_wincraft_installation" model="ir.sequence">
            <field name="name">WinCraft Installation</field>
            <field name="code">wincraft.installation</field>
            <field name="prefix">INS/%(y)s/</field>
            <field name="padding">4</field>
        </record>

    </data>
</odoo>
