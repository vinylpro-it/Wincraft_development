<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="wincraft_studio.DesignToolbar">
        <div class="wc-design-toolbar" t-att-class="{ 'wc-dtb-disabled': !hasWindow }">

            <!-- Dividers Group -->
            <div class="wc-dtb-group" t-if="hasWindow and showDividers">
                <span class="wc-dtb-group-label">Split &amp; Merge</span>
                <div class="wc-dtb-buttons">
                    <button t-att-class="{ 'wc-dtb-btn': true, 'wc-dtb-btn-disabled': !canAddMullion }"
                            t-att-disabled="!canAddMullion"
                            t-on-click="() => this.addDivider('vertical')"
                            t-att-draggable="canAddMullion ? 'true' : 'false'"
                            t-on-dragstart="canAddMullion and ((ev) => this.onDividerDragStart(ev, 'vertical'))"
                            title="Split panel vertically (add mullion)">
                        <svg width="18" height="18" viewBox="0 0 18 18">
                            <rect x="1" y="1" width="16" height="16" rx="1" fill="none" stroke="currentColor" stroke-width="1"/>
                            <line x1="9" y1="1" x2="9" y2="17" stroke="#4f6ef7" stroke-width="1.5" stroke-dasharray="2 1"/>
                        </svg>
                        <span>Split ↔</span>
                    </button>
                    <button t-att-class="{ 'wc-dtb-btn': true, 'wc-dtb-btn-disabled': !canAddTransom }"
                            t-att-disabled="!canAddTransom"
                            t-on-click="() => this.addDivider('horizontal')"
                            t-att-draggable="canAddTransom ? 'true' : 'false'"
                            t-on-dragstart="canAddTransom and ((ev) => this.onDividerDragStart(ev, 'horizontal'))"
                            title="Split panel horizontally (add transom)">
                        <svg width="18" height="18" viewBox="0 0 18 18">
                            <rect x="1" y="1" width="16" height="16" rx="1" fill="none" stroke="currentColor" stroke-width="1"/>
                            <line x1="1" y1="9" x2="17" y2="9" stroke="#4f6ef7" stroke-width="1.5" stroke-dasharray="2 1"/>
                        </svg>
                        <span>Split ↕</span>
                    </button>
                    <button t-att-class="{ 'wc-dtb-btn': true, 'wc-dtb-btn-disabled': !canMerge }"
                            t-att-disabled="!canMerge"
                            t-on-click="() => this.mergePanels()"
                            title="Merge selected panel with sibling">
                        <svg width="18" height="18" viewBox="0 0 18 18">
                            <rect x="1" y="1" width="16" height="16" rx="1" fill="none" stroke="currentColor" stroke-width="1"/>
                            <line x1="5" y1="9" x2="13" y2="9" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round"/>
                            <polyline points="7,6 5,9 7,12" fill="none" stroke="#ef4444" stroke-width="1" stroke-linecap="round"/>
                            <polyline points="11,6 13,9 11,12" fill="none" stroke="#ef4444" stroke-width="1" stroke-linecap="round"/>
                        </svg>
                        <span>Merge</span>
                    </button>
                </div>
            </div>

            <div class="wc-dtb-sep" t-if="hasWindow and showDividers"/>

            <!-- Opening Type Strip -->
            <div class="wc-dtb-group wc-dtb-group--opening" t-if="hasWindow">
                <div class="wc-dtb-ot-strip">
                    <t t-foreach="openingTypeGroups" t-as="group" t-key="group.id">
                        <div class="wc-dtb-ot-sep" t-if="!group_first"/>
                        <t t-foreach="group.types" t-as="ot" t-key="ot.key">
                            <button t-att-class="{ 'wc-dtb-ot-btn wc-dtb-ot-btn--icon-only': true, 'active': activeOpeningType === ot.key, 'wc-dtb-ot-btn--no-pane': !activeOpeningType, 'wc-dtb-ot-btn--disabled': ot.disabled }"
                                    t-on-click="() => this.onOpeningTypeClick(ot.key)"
                                    t-att-title="ot.disabled ? (ot.label + ' — not available for this window type') : ot.label">
                                <span class="wc-dtb-ot-icon" t-out="ot.svgIcon"/>
                            </button>
                        </t>
                    </t>
                </div>
            </div>

            <!-- Empty state -->
            <div class="wc-dtb-empty" t-if="!hasWindow">
                <i class="fa fa-info-circle"/>
                <span>Select or create a window to use design tools</span>
            </div>
        </div>
    </t>

</templates>
