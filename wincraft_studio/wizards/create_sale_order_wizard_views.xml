<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Wizard Form View ─────────────────────────────────────────────── -->
    <record id="view_wincraft_create_so_wizard_form" model="ir.ui.view">
        <field name="name">wincraft.create.so.wizard.form</field>
        <field name="model">wincraft.create.so.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Sale Order">
                <sheet>
                    <group>
                        <group string="Project">
                            <field name="project_id"
                                   readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="partner_id"
                                   options="{'no_create': True}"/>
                            <field name="pricelist_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Windows to Include">
                        <field name="window_ids"
                               widget="many2many_checkboxes"
                               nolabel="1"
                               domain="[('project_id', '=', project_id)]"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_sale_order"
                            string="Create Sale Order"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Window Action ────────────────────────────────────────────────── -->
    <record id="action_wincraft_create_so_wizard" model="ir.actions.act_window">
        <field name="name">Create Sale Order</field>
        <field name="res_model">wincraft.create.so.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="wincraft_studio.model_wincraft_project"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
